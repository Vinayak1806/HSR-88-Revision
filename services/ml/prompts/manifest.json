{
  "$schema": "./manifest.schema.json",
  "bundleVersion": "0.1.0",
  "prompts": {
    "doubt-solver": "v1.doubt-solver.md",
    "question-generation": "v1.question-generation.md",
    "question-validation-judge": "v1.question-validation-judge.md",
    "test-assembly": "v1.test-assembly.md"
  },
  "models": {
    "doubt-solver": { "provider": "anthropic", "model": "claude-sonnet-5", "temperature": 0.3 },
    "question-generation": { "provider": "anthropic", "model": "claude-sonnet-5", "temperature": 0.7 },
    "question-validation-judge": { "provider": "anthropic", "model": "claude-sonnet-5", "temperature": 0 },
    "test-assembly": { "provider": "anthropic", "model": "claude-sonnet-5", "temperature": 0.2 }
  }
}
