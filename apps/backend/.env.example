# Copy to .env — never commit real values.
NODE_ENV=development
PORT=4000

MONGO_URI=mongodb://localhost:27017/neet

JWT_ACCESS_SECRET=change-me-32-chars-min
JWT_REFRESH_SECRET=change-me-32-chars-min
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

CORS_ORIGINS=http://localhost:5173

AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-sonnet-5
AI_DAILY_DOUBT_LIMIT=5

LOG_LEVEL=info
SENTRY_DSN=
